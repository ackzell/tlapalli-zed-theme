{
  "name": "tlapalli-zed-theme",
  "version": "1.2.0",
  "description": "Tlah-PAH-lee means color in Náhuatl. Monochromatic theme with dark and light colored variations. Inspired by minerals found in Mexico",
  "scripts": {
    "prepare": "is-ci || husky",
    "cz": "exec < /dev/tty && npx cz --hook || true",
    "tag": "commit-and-tag-version -- --no-verify",
    "tag:minor": "commit-and-tag-version --release-as minor -- --no-verify",
    "tag:major": "commit-and-tag-version --release-as major -- --no-verify",
    "publish": "git push --follow-tags"
  },
  "devDependencies": {
    "commit-and-tag-version": "^12.6.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
